<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="theme-color" content="#08090d" />
<title>BrandLens — Clarity in Every Impression</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Manrope:wght@400;500;600;700;800&display=swap');

  :root {
    --bg: #08090d;
    --ink: #f4f4f7;
    --muted: #92939f;
    --line: rgba(255,255,255,.13);
    --violet: #a68bff;
    --cyan: #9cecff;
    --ease: cubic-bezier(.2,.75,.2,1);
  }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    margin: 0; min-height: 100vh; background: var(--bg); color: var(--ink);
    font-family: "Manrope", system-ui, sans-serif; overflow-x: hidden;
  }
  body::before {
    content:""; position:fixed; inset:0; pointer-events:none; z-index:0;
    background:
      radial-gradient(ellipse at 50% 48%, rgba(85,76,130,.13), transparent 43%),
      radial-gradient(ellipse at 80% 15%, rgba(58,111,132,.07), transparent 32%),
      linear-gradient(180deg, #090a0f 0%, #08090d 100%);
  }
  body::after {
    content:""; position:fixed; inset:0; pointer-events:none; z-index:10; opacity:.12;
    background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.18'/%3E%3C/svg%3E");
    mix-blend-mode:soft-light;
  }
  button, input { font: inherit; }
  button { color: inherit; }
  .stage { position:relative; min-height:100svh; isolation:isolate; }
  .intro {
    position:fixed; inset:0; z-index:20; display:grid; place-items:center;
    background:#08090d; transition:opacity 1s var(--ease), visibility 1s;
  }
  .intro.done { opacity:0; visibility:hidden; pointer-events:none; }
  .intro-core { text-align:center; position:relative; padding:2rem; }
  .intro-mark {
    width:28px; height:28px; margin:0 auto 23px; position:relative; opacity:0;
    animation:markIn 1.2s .25s var(--ease) forwards;
  }
  .intro-mark::before, .intro-mark::after {
    content:""; position:absolute; inset:1px; border:1px solid rgba(202,192,255,.8); border-radius:50%;
  }
  .intro-mark::after { inset:7px; border-color:rgba(156,236,255,.9); box-shadow:0 0 20px rgba(156,236,255,.25); }
  .intro-name {
    font-size:clamp(2.8rem,8vw,6.8rem); font-weight:600; letter-spacing:.22em;
    margin:0; padding-left:.22em; opacity:0; filter:blur(14px); transform:translateY(12px);
    animation:titleIn 1.35s .45s var(--ease) forwards, titleOut .85s 2.55s var(--ease) forwards;
    white-space:nowrap;
  }
  .intro-name span { color:#c8bbff; text-shadow:0 0 38px rgba(166,139,255,.25); }
  .intro-line {
    width:0; height:1px; margin:25px auto 0;
    background:linear-gradient(90deg,transparent,var(--violet),var(--cyan),transparent);
    animation:lineGrow 1.2s .85s var(--ease) forwards, lineOut .5s 2.7s ease forwards;
  }
  .intro-caption {
    margin:17px 0 0; font:10px "DM Mono",monospace; letter-spacing:.32em;
    color:#81818e; opacity:0; animation:captionIn .7s 1.1s ease forwards, fadeAway .45s 2.65s ease forwards;
  }
  .intro-skip {
    position:absolute; bottom:30px; left:50%; transform:translateX(-50%);
    color:#686975; background:none; border:0; font:10px "DM Mono",monospace;
    letter-spacing:.18em; cursor:pointer; padding:12px; transition:color .2s;
  }
  .intro-skip:hover { color:#fff; }
  @keyframes titleIn { to { opacity:1; filter:blur(0); transform:translateY(0); } }
  @keyframes titleOut { to { opacity:0; filter:blur(12px); transform:translateY(-8px); letter-spacing:.38em; } }
  @keyframes markIn { to { opacity:.9; transform:rotate(90deg); } }
  @keyframes lineGrow { to { width:min(340px,70vw); } }
  @keyframes lineOut { to { opacity:0; width:0; } }
  @keyframes captionIn { to { opacity:1; } }
  @keyframes fadeAway { to { opacity:0; } }

  .ambient { position:fixed; inset:0; pointer-events:none; z-index:-1; overflow:hidden; }
  .haze {
    position:absolute; width:min(62vw,780px); aspect-ratio:1; border-radius:50%;
    left:50%; top:48%; transform:translate(-50%,-50%);
    background:radial-gradient(circle,rgba(117,96,185,.105) 0%,rgba(73,100,133,.045) 32%,transparent 68%);
    filter:blur(14px); animation:hazeBreathe 9s ease-in-out infinite alternate;
  }
  .lens {
    position:absolute; width:min(70vw,850px); aspect-ratio:1; left:50%; top:48%;
    transform:translate(-50%,-50%); border-radius:50%;
    border:1px solid rgba(205,201,255,.045);
    box-shadow:inset 0 0 100px rgba(120,105,180,.025), 0 0 100px rgba(80,150,180,.018);
    opacity:.85; transition:transform 1.4s var(--ease), opacity 1s;
  }
  .lens::before, .lens::after {
    content:""; position:absolute; border-radius:50%; inset:9%;
    border:1px solid rgba(156,236,255,.055); transform:rotate(-28deg) scaleX(.8);
  }
  .lens::after { inset:20%; border-color:rgba(190,170,255,.055); transform:rotate(25deg) scaleX(1.13); }
  .light-streak {
    position:absolute; width:1px; height:36vh; top:30%; left:16%;
    background:linear-gradient(transparent,rgba(156,236,255,.22),transparent);
    opacity:0; transform:rotate(24deg); animation:streak 9s 3s ease-in-out infinite;
  }
  .light-streak.two { left:83%; top:55%; height:24vh; animation-delay:6s; transform:rotate(-22deg); }
  .grain-dot { position:absolute; width:2px; height:2px; border-radius:50%; background:#b8c8ff; opacity:0; animation:drift 10s ease-in-out infinite; }
  @keyframes hazeBreathe { from { opacity:.65; transform:translate(-50%,-50%) scale(.92); } to { opacity:1; transform:translate(-50%,-50%) scale(1.08); } }
  @keyframes streak { 0%,100% { opacity:0; transform:translateY(-18px) rotate(24deg); } 35% { opacity:.65; } 65% { opacity:.15; transform:translateY(30px) rotate(24deg); } }
  @keyframes drift { 0%,100% { opacity:0; transform:translate3d(0,0,0); } 25% { opacity:.3; } 70% { opacity:.08; transform:translate3d(16px,-30px,0); } }

  .thoughts {
    position:fixed; inset:0; z-index:15; display:grid; place-items:center;
    pointer-events:none; opacity:0; transition:opacity .5s;
  }
  .thoughts.active { opacity:1; }
  .thought {
    position:absolute; margin:0; width:90%; text-align:center;
    font-size:clamp(1.2rem,3.2vw,2.5rem); font-weight:500; letter-spacing:-.045em;
    color:#e8e7ee; opacity:0; filter:blur(8px); transform:translateY(12px);
    transition:opacity .8s var(--ease), filter .8s var(--ease), transform .8s var(--ease);
  }
  .thought.active { opacity:1; filter:blur(0); transform:translateY(0); }
  .thought em { color:#bcaaff; font-style:normal; }

  .site { position:relative; z-index:1; min-height:100svh; opacity:0; transform:translateY(8px); transition:opacity 1.2s var(--ease), transform 1.2s var(--ease); }
  .site.visible { opacity:1; transform:translateY(0); }
  .topbar { height:84px; padding:0 clamp(22px,5vw,76px); display:flex; align-items:center; justify-content:space-between; }
  .wordmark { display:flex; align-items:center; gap:10px; font-size:14px; letter-spacing:-.04em; font-weight:700; }
  .wordmark-icon { width:19px; height:19px; border:1px solid rgba(195,183,255,.9); border-radius:50%; position:relative; }
  .wordmark-icon::after { content:""; position:absolute; inset:5px; border:1px solid rgba(156,236,255,.9); border-radius:50%; }
  .system-status { display:flex; align-items:center; gap:9px; color:#858591; font:9px "DM Mono",monospace; letter-spacing:.12em; }
  .status-dot { width:5px; height:5px; border-radius:50%; background:#a4e6cf; box-shadow:0 0 12px rgba(164,230,207,.7); }
  .hero { min-height:calc(100svh - 145px); display:flex; align-items:center; justify-content:center; flex-direction:column; text-align:center; padding:40px 24px 72px; }
  .eyebrow { display:flex; align-items:center; gap:11px; color:#aaa7b7; font:10px "DM Mono",monospace; letter-spacing:.18em; text-transform:uppercase; margin-bottom:29px; opacity:0; animation:rise .8s .15s var(--ease) forwards; }
  .eyebrow::before { content:""; width:26px; height:1px; background:linear-gradient(90deg,var(--violet),var(--cyan)); }
  .hero h1 {
    font-size:clamp(3.2rem,9.5vw,8.7rem); line-height:.98; letter-spacing:-.085em; font-weight:500;
    margin:0; max-width:1000px; opacity:0; animation:rise 1s .3s var(--ease) forwards;
  }
  .hero h1 .second-line { display:block; color:#a8a0c5; }
  .hero h1 .quiet { color:#f3f2f7; }
  .hero-copy { max-width:410px; color:#9a9aa6; font-size:14px; line-height:1.9; margin:30px auto 0; opacity:0; animation:rise .9s .5s var(--ease) forwards; }
  .enter-btn {
    margin-top:42px; min-width:202px; display:inline-flex; align-items:center; justify-content:center; gap:18px;
    background:transparent; color:#f5f4fa; border:1px solid rgba(213,207,255,.28); border-radius:2px;
    padding:16px 20px; font:10px "DM Mono",monospace; letter-spacing:.16em; cursor:pointer; position:relative; overflow:hidden;
    opacity:0; animation:rise .9s .68s var(--ease) forwards; transition:border-color .3s, color .3s, transform .3s;
  }
  .enter-btn::before { content:""; position:absolute; inset:0; background:linear-gradient(100deg,transparent,rgba(166,139,255,.14),rgba(156,236,255,.1),transparent); transform:translateX(-110%); transition:transform .7s var(--ease); }
  .enter-btn:hover { border-color:rgba(190,177,255,.8); transform:translateY(-2px); }
  .enter-btn:hover::before { transform:translateX(110%); }
  .enter-btn span, .enter-btn b { position:relative; z-index:1; font-weight:400; }
  .bottomline { position:absolute; bottom:25px; left:clamp(22px,5vw,76px); right:clamp(22px,5vw,76px); display:flex; justify-content:space-between; color:#676875; font:9px "DM Mono",monospace; letter-spacing:.14em; }
  .bottomline .coordinates { color:#777785; }

  .login-view { position:fixed; inset:0; z-index:12; display:grid; place-items:center; padding:24px; opacity:0; visibility:hidden; transform:scale(1.02); transition:opacity .7s var(--ease), visibility .7s, transform .7s var(--ease); }
  .login-view.active { opacity:1; visibility:visible; transform:scale(1); }
  .login-backdrop { position:absolute; inset:0; background:rgba(7,8,13,.42); backdrop-filter:blur(0); transition:backdrop-filter .8s, background .8s; }
  .login-view.active .login-backdrop { background:rgba(7,8,13,.62); backdrop-filter:blur(7px); }
  .login-panel { width:min(100%,420px); position:relative; border:1px solid rgba(206,197,255,.17); background:linear-gradient(145deg,rgba(23,23,34,.84),rgba(12,13,20,.9)); box-shadow:0 30px 120px rgba(0,0,0,.4); padding:clamp(27px,5vw,42px); }
  .login-panel::before { content:""; position:absolute; top:-1px; left:22%; right:22%; height:1px; background:linear-gradient(90deg,transparent,var(--violet),var(--cyan),transparent); }
  .login-top { display:flex; align-items:center; justify-content:space-between; margin-bottom:38px; }
  .login-brand { display:flex; align-items:center; gap:9px; font-size:13px; font-weight:700; }
  .close-login { border:0; background:transparent; color:#8b8a98; cursor:pointer; font-size:22px; padding:2px 4px; transition:color .2s; }
  .close-login:hover { color:#fff; }
  .login-panel h2 { font-size:29px; letter-spacing:-.06em; font-weight:500; margin:0 0 7px; }
  .login-sub { color:#91919f; font-size:12px; margin:0 0 30px; }
  .field { margin-bottom:19px; }
  .field label { display:block; color:#b7b5c4; font:10px "DM Mono",monospace; letter-spacing:.12em; margin-bottom:9px; text-transform:uppercase; }
  .input-wrap { position:relative; }
  .field input, .field select {
    display:block; width:100%; border:1px solid rgba(255,255,255,.13); border-radius:2px;
    background:rgba(5,6,11,.55); color:#f3f2f7; padding:14px 13px; outline:none; font-size:13px;
    transition:border-color .25s, box-shadow .25s;
  }
  .field select { appearance:none; cursor:pointer; }
  .field select option { background:#15151e; color:#fff; }
  .field input:focus, .field select:focus { border-color:rgba(177,158,255,.8); box-shadow:0 0 0 3px rgba(166,139,255,.08); }
  .field input::placeholder { color:#626270; }
  .password-input { padding-right:70px !important; }
  .show-pass { position:absolute; right:10px; top:50%; transform:translateY(-50%); background:none; border:0; color:#8f8d9c; font:9px "DM Mono",monospace; letter-spacing:.06em; cursor:pointer; padding:6px; }
  .sign-in { width:100%; margin-top:6px; border:1px solid rgba(194,182,255,.55); background:linear-gradient(100deg,rgba(138,114,211,.2),rgba(93,157,177,.12)); padding:15px; color:#fff; cursor:pointer; font:10px "DM Mono",monospace; letter-spacing:.18em; transition:background .25s, border-color .25s, transform .25s; }
  .sign-in:hover { border-color:#c7bbff; background:linear-gradient(100deg,rgba(138,114,211,.34),rgba(93,157,177,.22)); transform:translateY(-1px); }
  .form-message { min-height:18px; margin:12px 0 0; font-size:11px; line-height:1.6; color:#ffb6bd; }
  .demo { border-top:1px solid rgba(255,255,255,.1); margin-top:18px; padding-top:15px; }
  .demo-toggle { width:100%; display:flex; align-items:center; justify-content:space-between; border:0; background:transparent; color:#8f8d9c; cursor:pointer; padding:2px 0; font:9px "DM Mono",monospace; letter-spacing:.13em; }
  .demo-toggle:hover { color:#e4e0f2; }
  .demo-list { display:none; padding-top:12px; gap:5px; }
  .demo-list.open { display:grid; }
  .demo-row { display:flex; align-items:center; justify-content:space-between; text-align:left; gap:12px; padding:10px 9px; background:rgba(255,255,255,.025); border:1px solid transparent; cursor:pointer; transition:background .2s,border-color .2s; }
  .demo-row:hover { background:rgba(166,139,255,.07); border-color:rgba(166,139,255,.22); }
  .demo-role { font-size:11px; color:#e5e2ee; }
  .demo-user { color:#7e7d8c; font:9px "DM Mono",monospace; }
  .demo-note { color:#666674; font-size:9px; margin:11px 0 0; line-height:1.6; }
  .welcome-view { position:fixed; inset:0; z-index:14; display:grid; place-items:center; padding:24px; text-align:center; opacity:0; visibility:hidden; transition:opacity .7s,visibility .7s; }
  .welcome-view.active { opacity:1; visibility:visible; }
  .welcome-inner { max-width:600px; }
  .access-label { font:10px "DM Mono",monospace; letter-spacing:.25em; color:#a8e8d0; margin-bottom:28px; }
  .access-label::before { content:""; display:inline-block; width:5px; height:5px; background:#a8e8d0; border-radius:50%; margin:0 10px 2px 0; box-shadow:0 0 12px #a8e8d0; }
  .welcome-inner h2 { font-size:clamp(2.6rem,8vw,6rem); font-weight:500; letter-spacing:-.08em; line-height:1; margin:0; }
  .welcome-inner p { color:#9a9aa6; font-size:13px; margin:24px 0 30px; }
  .role-pill { display:inline-block; border:1px solid rgba(190,177,255,.3); color:#c9beff; padding:9px 13px; font:10px "DM Mono",monospace; letter-spacing:.12em; text-transform:uppercase; }
  .logout { display:block; margin:32px auto 0; color:#92919e; border:0; border-bottom:1px solid rgba(255,255,255,.25); padding:8px 0; background:transparent; cursor:pointer; font:10px "DM Mono",monospace; letter-spacing:.15em; }
  .logout:hover { color:#fff; border-color:#fff; }
  .hidden { display:none !important; }
  @keyframes rise { from { opacity:0; transform:translateY(16px); filter:blur(5px); } to { opacity:1; transform:translateY(0); filter:blur(0); } }

  @media (max-width:600px) {
    .topbar { height:68px; }
    .system-status { font-size:7px; letter-spacing:.06em; gap:6px; }
    .hero { min-height:calc(100svh - 110px); padding-bottom:84px; }
    .hero h1 { letter-spacing:-.075em; }
    .hero-copy { font-size:13px; max-width:300px; }
    .bottomline { bottom:18px; font-size:7px; letter-spacing:.08em; }
    .bottomline .coordinates { display:none; }
    .lens { width:110vw; }
    .intro-name { letter-spacing:.12em; padding-left:.12em; }
    .login-panel { padding:26px 22px; }
  }
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after { animation-duration:.01ms !important; animation-iteration-count:1 !important; scroll-behavior:auto !important; transition-duration:.01ms !important; }
  }
</style>
</head>
<body>
<div class="stage">
  <div class="ambient" aria-hidden="true">
    <div class="haze"></div><div class="lens"></div><div class="light-streak"></div><div class="light-streak two"></div>
    <span class="grain-dot" style="left:17%;top:26%;animation-delay:1s"></span>
    <span class="grain-dot" style="left:72%;top:19%;animation-delay:3s"></span>
    <span class="grain-dot" style="left:81%;top:72%;animation-delay:2s"></span>
    <span class="grain-dot" style="left:31%;top:79%;animation-delay:5s"></span>
    <span class="grain-dot" style="left:60%;top:63%;animation-delay:4s"></span>
  </div>

  <section class="intro" id="intro" aria-label="BrandLens introduction">
    <div class="intro-core">
      <div class="intro-mark"></div>
      <h1 class="intro-name">Brand<span>Lens</span></h1>
      <div class="intro-line"></div>
      <p class="intro-caption">CLARITY IN EVERY IMPRESSION</p>
    </div>
    <button class="intro-skip" id="skipIntro">SKIP INTRO ↗</button>
  </section>

  <section class="thoughts" id="thoughts" aria-hidden="true">
    <p class="thought">Every detail has a <em>meaning.</em></p>
    <p class="thought">Every word leaves a <em>mark.</em></p>
    <p class="thought">Every brand has a <em>standard.</em></p>
    <p class="thought">Precision is not an <em>accident.</em></p>
    <p class="thought">Make every impression <em>count.</em></p>
  </section>

  <main class="site" id="site">
    <header class="topbar">
      <div class="wordmark"><span class="wordmark-icon"></span>BrandLens</div>
      <div class="system-status"><span class="status-dot"></span> BRAND INTELLIGENCE SYSTEM · ONLINE</div>
    </header>
    <section class="hero">
      <div class="eyebrow">AI-POWERED BRAND CLARITY</div>
      <h1><span class="quiet">Your brand.</span><span class="second-line">Without the noise.</span></h1>
      <p class="hero-copy">An intelligent space where every message stays true to your identity.</p>
      <button class="enter-btn" id="enterBtn"><span>ENTER BRANDLENS</span><b>↗</b></button>
    </section>
    <footer class="bottomline"><span>BUILT FOR CLARITY. DESIGNED FOR TRUST.</span><span class="coordinates">LESS NOISE / MORE MEANING</span></footer>
  </main>

  <section class="login-view" id="loginView" aria-label="Sign in">
    <div class="login-backdrop" id="loginBackdrop"></div>
    <div class="login-panel">
      <div class="login-top">
        <div class="login-brand"><span class="wordmark-icon"></span>BrandLens</div>
        <button class="close-login" id="closeLogin" aria-label="Back to landing page">×</button>
      </div>
      <h2>Enter your workspace.</h2>
      <p class="login-sub">A clearer view starts here.</p>
      <form id="loginForm" novalidate>
        <div class="field">
          <label for="username">Username</label>
          <input id="username" name="username" autocomplete="username" placeholder="Enter your username" required />
        </div>
        <div class="field">
          <label for="password">Password</label>
          <div class="input-wrap">
            <input class="password-input" id="password" name="password" type="password" autocomplete="current-password" placeholder="Enter your password" required />
            <button type="button" class="show-pass" id="showPass">SHOW</button>
          </div>
        </div>
        <div class="field">
          <label for="role">Workspace role</label>
          <select id="role" name="role">
            <option value="Employee">Employee</option>
            <option value="Manager">Manager</option>
            <option value="CEO">CEO</option>
            <option value="Administrator">Administrator</option>
          </select>
        </div>
        <button class="sign-in" type="submit">SIGN IN <span aria-hidden="true">↗</span></button>
        <p class="form-message" id="formMessage" role="status" aria-live="polite"></p>
      </form>
      <div class="demo">
        <button class="demo-toggle" id="demoToggle" aria-expanded="false"><span>DEMO ACCESS</span><span id="demoChevron">＋</span></button>
        <div class="demo-list" id="demoList">
          <button class="demo-row" data-user="employee" data-pass="employee123" data-role="Employee"><span class="demo-role">Employee</span><span class="demo-user">employee</span></button>
          <button class="demo-row" data-user="manager" data-pass="manager123" data-role="Manager"><span class="demo-role">Manager</span><span class="demo-user">manager</span></button>
          <button class="demo-row" data-user="ceo" data-pass="ceo123" data-role="CEO"><span class="demo-role">CEO</span><span class="demo-user">ceo</span></button>
          <button class="demo-row" data-user="admin" data-pass="admin123" data-role="Administrator"><span class="demo-role">Administrator</span><span class="demo-user">admin</span></button>
          <p class="demo-note">Demo-only frontend login. Do not use real passwords.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="welcome-view" id="welcomeView" aria-label="Signed in">
    <div class="welcome-inner">
      <div class="access-label">ACCESS GRANTED</div>
      <h2 id="welcomeTitle">Welcome back.</h2>
      <p>Your BrandLens workspace is ready.</p>
      <span class="role-pill" id="welcomeRole">EMPLOYEE</span>
      <button class="logout" id="logoutBtn">LOG OUT ↗</button>
    </div>
  </section>
</div>
<script>
(() => {
  const intro = document.getElementById('intro');
  const thoughts = document.getElementById('thoughts');
  const thoughtEls = [...document.querySelectorAll('.thought')];
  const site = document.getElementById('site');
  const loginView = document.getElementById('loginView');
  const welcomeView = document.getElementById('welcomeView');
  const form = document.getElementById('loginForm');
  const username = document.getElementById('username');
  const password = document.getElementById('password');
  const role = document.getElementById('role');
  const message = document.getElementById('formMessage');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  let introFinished = false;
  let thoughtTimers = [];

  function clearThoughtTimers() {
    thoughtTimers.forEach(clearTimeout);
    thoughtTimers = [];
    thoughtEls.forEach(el => el.classList.remove('active'));
  }

  function showLanding() {
    intro.classList.add('done');
    thoughts.classList.remove('active');
    site.classList.add('visible');
    clearThoughtTimers();
    introFinished = true;
  }

  function runIntro() {
    if (reducedMotion) { showLanding(); return; }
    introFinished = false;
    thoughtEls.forEach(el => el.classList.remove('active'));
    site.classList.remove('visible');
    thoughts.classList.remove('active');
    intro.classList.remove('done');
    thoughtTimers.push(setTimeout(() => {
      intro.classList.add('done');
      thoughts.classList.add('active');
      thoughtEls.forEach((el, i) => {
        thoughtTimers.push(setTimeout(() => {
          thoughtEls.forEach(other => other.classList.remove('active'));
          el.classList.add('active');
        }, i * 1120 + 120));
      });
      thoughtTimers.push(setTimeout(showLanding, thoughtEls.length * 1120 + 350));
    }, 3450));
  }
  document.getElementById('skipIntro').addEventListener('click', showLanding);
  document.addEventListener('keydown', e => {
    if (!introFinished && (e.key === 'Enter' || e.key === ' ')) showLanding();
    if (e.key === 'Escape') closeLogin();
  });
  runIntro();

  function openLogin() {
    loginView.classList.add('active');
    welcomeView.classList.remove('active');
    message.textContent = '';
    setTimeout(() => username.focus(), 350);
  }
  function closeLogin() {
    loginView.classList.remove('active');
    welcomeView.classList.remove('active');
    site.classList.add('visible');
  }
  document.getElementById('enterBtn').addEventListener('click', openLogin);
  document.getElementById('closeLogin').addEventListener('click', closeLogin);
  document.getElementById('loginBackdrop').addEventListener('click', closeLogin);

  document.getElementById('showPass').addEventListener('click', () => {
    const isPassword = password.type === 'password';
    password.type = isPassword ? 'text' : 'password';
    document.getElementById('showPass').textContent = isPassword ? 'HIDE' : 'SHOW';
  });

  const demoToggle = document.getElementById('demoToggle');
  const demoList = document.getElementById('demoList');
  demoToggle.addEventListener('click', () => {
    const open = demoList.classList.toggle('open');
    demoToggle.setAttribute('aria-expanded', String(open));
    document.getElementById('demoChevron').textContent = open ? '−' : '＋';
  });
  document.querySelectorAll('.demo-row').forEach(row => {
    row.addEventListener('click', () => {
      username.value = row.dataset.user;
      password.value = row.dataset.pass;
      role.value = row.dataset.role;
      message.textContent = '';
      username.focus();
    });
  });

  const accounts = {
    employee: { password: 'employee123', role: 'Employee' },
    manager: { password: 'manager123', role: 'Manager' },
    ceo: { password: 'ceo123', role: 'CEO' },
    admin: { password: 'admin123', role: 'Administrator' }
  };
  form.addEventListener('submit', e => {
    e.preventDefault();
    const user = username.value.trim().toLowerCase();
    const pass = password.value;
    const selectedRole = role.value;
    const account = accounts[user];
    if (!user || !pass) {
      message.textContent = 'Enter your username and password to continue.';
      return;
    }
    if (!account || account.password !== pass || account.role !== selectedRole) {
      message.textContent = 'Those details do not match this workspace role. Please try again.';
      return;
    }
    message.style.color = '#a8e8d0';
    message.textContent = 'Access verified. Opening workspace…';
    setTimeout(() => {
      loginView.classList.remove('active');
      site.classList.remove('visible');
      document.getElementById('welcomeTitle').textContent = 'Welcome back.';
      document.getElementById('welcomeRole').textContent = account.role.toUpperCase();
      welcomeView.classList.add('active');
      message.style.color = '';
    }, 550);
  });
  document.getElementById('logoutBtn').addEventListener('click', () => {
    welcomeView.classList.remove('active');
    loginView.classList.add('active');
    password.value = '';
    message.textContent = '';
  });

  // Gentle pointer-responsive light, disabled on touch/reduced-motion devices.
  if (!reducedMotion && window.matchMedia('(pointer:fine)').matches) {
    document.addEventListener('pointermove', e => {
      const x = (e.clientX / window.innerWidth - .5) * 18;
      const y = (e.clientY / window.innerHeight - .5) * 18;
      document.querySelector('.lens').style.transform = `translate(calc(-50% + ${x}px), calc(-50% + ${y}px))`;
    }, { passive: true });
  }
})();
</script>
</body>
</html>
